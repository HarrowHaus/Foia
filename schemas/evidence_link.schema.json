{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceLink",
  "type": "object",
  "required": [
    "evidence_id",
    "claim_id",
    "document_id",
    "relationship"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^evd_"
    },
    "claim_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "page_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "relationship": {
      "enum": [
        "supports",
        "contradicts",
        "contextualizes",
        "source_of_lead"
      ]
    },
    "excerpt": {
      "type": [
        "string",
        "null"
      ]
    },
    "establishes": {
      "type": [
        "string",
        "null"
      ]
    },
    "does_not_establish": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
